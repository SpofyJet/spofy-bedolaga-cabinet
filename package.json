{
  "name": "cabinet-frontend",
  "private": true,
  "version": "1.81.1",
  "description": "Remnawave Bedolaga Web App",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:docker": "vite build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kastov/cryptohapp": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@sigma/node-border": "^4.0.0",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-table": "^9.3.1",
    "@telegram-apps/sdk-react": "^3.3.9",
    "autoprefixer": "^10.7.0",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.18",
    "framer-motion": "^14.14.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "jsencrypt": "^3.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.2",
    "react-twemoji": "^0.7.2",
    "react-zoom-pan-pinch": "^4.4.0",
    "recharts": "^3.11.0",
    "sigma": "^4.0.6",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-twemoji": "^0.4.3",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "typescript-compiler-api": "npm:typescript@^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.css": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "valibot": "^1.4.2",
    "postcss-selector-parser": "^7.1.7"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
